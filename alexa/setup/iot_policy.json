{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:Subscribe",
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topic/$aws/things/devialet-expert*/shadow/*",
        "arn:aws:iot:*:*:topicfilter/$aws/things/devialet-expert*/shadow/*"
      ]
    }
  ]
}
